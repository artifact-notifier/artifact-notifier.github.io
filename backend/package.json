{
  "name": "artifact-notifier-backend",
  "version": "1.0.0",
  "description": "Backend NestJS for real-time artifact version notifications",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.8",
    "joi": "^18.0.0",
    "nodemailer": "10.2.1",
    "openid-client": "^6.0.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/**/*.module.ts",
      "!src/i18n/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
