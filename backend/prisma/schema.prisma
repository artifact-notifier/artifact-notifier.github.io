generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  avatarUrl        String?
  // Primary identity (first provider used). Additional providers are linked
  // via LinkedIdentity so several OAuth providers can share one account.
  provider         String
  providerSubject  String
  createdAt        DateTime @default(now())

  identities         LinkedIdentity[]
  preferences      UserPreferences?
  followedArtifacts FollowedArtifact[]
  deliveries       NotificationDelivery[]
  projects         Project[]
}

model LinkedIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
}

model UserPreferences {
  userId                String            @id
  email                 String
  notificationMode      NotificationMode  @default(IMMEDIATE)
  digestIntervalMinutes Int               @default(1440)
  locale                String            @default("fr")
  theme                 String            @default("system")
  notificationChannel   String            @default("email")
  // Notify alpha/beta/milestone/RC/SNAPSHOT versions too
  includePrereleases    Boolean           @default(false)
  telegramChatId        String?           @unique
  telegramUsername    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FollowedArtifact {
  id         String   @id @default(cuid())
  userId     String
  ecosystem  Ecosystem
  coordinates String
  currentVersion String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     ArtifactVersionEvent[]

  @@unique([userId, ecosystem, coordinates])
}

model ArtifactVersionEvent {
  id                  String   @id @default(cuid())
  followedArtifactId  String
  ecosystem           Ecosystem
  coordinates         String
  version             String
  publishedAt         DateTime @default(now())

  followedArtifact    FollowedArtifact @relation(fields: [followedArtifactId], references: [id], onDelete: Cascade)
  deliveries          NotificationDelivery[]

  @@unique([followedArtifactId, version])
}

// Versions already seen per artifact, shared by all followers: a version absent
// from this list is new (whatever its position relative to the current one).
// One row per artifact (JSON array): popular packages have thousands of versions,
// one row per version made following a few dozen artifacts a write storm.
model KnownVersions {
  ecosystem   Ecosystem
  coordinates String
  versions    String // JSON array of version strings

  @@id([ecosystem, coordinates])
}

model NotificationDelivery {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  status    DeliveryStatus    @default(PENDING)
  channel   String            @default("email")
  // Failed sends go back to PENDING with a growing delay, up to a max number of attempts
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  sentAt    DateTime?
  createdAt DateTime          @default(now())

  event     ArtifactVersionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, channel])
}

// A user's project: dependency files imported from the browser (parsed there),
// grouped by source. Follows stay one per artifact (FollowedArtifact): a project
// only references artifacts, so one shared by several projects is notified once.
model Project {
  id        String          @id @default(cuid())
  userId    String
  name      String
  // skip versions not newer than the one this project uses (e.g. patches of older lines)
  notifyNewerOnly Boolean   @default(false)
  createdAt DateTime        @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   ProjectSource[]

  @@unique([userId, name])
}

// One imported manifest (+ its lockfile), e.g. "front/package.json"
model ProjectSource {
  id           String              @id @default(cuid())
  projectId    String
  label        String
  kind         String
  ecosystem    Ecosystem
  updatedAt    DateTime            @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependencies ProjectDependency[]

  @@unique([projectId, label])
}

// Every direct dependency found in a source, followed or not: the follow state
// is the user's FollowedArtifact with the same ecosystem + coordinates.
model ProjectDependency {
  id          String        @id @default(cuid())
  sourceId    String
  coordinates String
  declared    String?
  version     String?
  scope       String

  source      ProjectSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, coordinates])
  @@index([coordinates])
}

model ListenerSequence {
  id    String @id
  value String
}

enum Ecosystem {
  NPM
  MAVEN
  PYPI
  TEST
}

enum NotificationMode {
  IMMEDIATE
  DIGEST
}

enum DeliveryStatus {
  PENDING
  // claimed by a sender (immediate or digest), so a delivery is never sent twice
  SENDING
  SENT
  FAILED
}
