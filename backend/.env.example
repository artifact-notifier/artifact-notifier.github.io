# ---- App ----
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:4200
# URL publique de l'API (redirect_uri OIDC + détection cross-site).
# Vide = même origine (proxy front). Cross-origin : ex. https://api.example.com
BACKEND_PUBLIC_URL=
NODE_ENV=development
# Log verbosity threshold: error < warn < log (default) < debug < verbose
# Use debug/verbose to see listener polling details, warn/error to quiet them.
LOG_LEVEL=log

# ---- Database (SQLite + Prisma) ----
DATABASE_URL="file:./dev.db"

# ---- JWT (session for the SPA) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- SMTP / Mailtrap (default) ----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
MAIL_FROM="Artifact Notifier <no-reply@artifact-notifier.dev>"
# Minimum digest interval (minutes) for mail (daily or slower: 1440/10080/43200).
# Lower it in dev for faster testing, e.g. MAIL_MIN_DIGEST_INTERVAL_MINUTES=1
MAIL_MIN_DIGEST_INTERVAL_MINUTES=1440

# ---- OIDC providers (enable any subset) ----
# Each provider is referenced by its key (lowercase). Only declared providers are loaded.
OIDC_PROVIDERS=google,github,facebook

# Google (OIDC discovery)
OIDC_GOOGLE_DISPLAY_NAME=Google
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=your-google-client-id
OIDC_GOOGLE_CLIENT_SECRET=your-google-client-secret
OIDC_GOOGLE_SCOPES=openid profile email

# GitHub (manual endpoints, no discovery)
OIDC_GITHUB_DISPLAY_NAME=GitHub
OIDC_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
OIDC_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
OIDC_GITHUB_USERINFO_ENDPOINT=https://api.github.com/user
OIDC_GITHUB_CLIENT_ID=your-github-client-id
OIDC_GITHUB_CLIENT_SECRET=your-github-client-secret
OIDC_GITHUB_SCOPES=read:user user:email

# Facebook (OIDC discovery)
OIDC_FACEBOOK_DISPLAY_NAME=Facebook
OIDC_FACEBOOK_ISSUER=https://www.facebook.com
OIDC_FACEBOOK_CLIENT_ID=your-facebook-client-id
OIDC_FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
OIDC_FACEBOOK_SCOPES=email public_profile

# Telegram Bot (OAuth + notifications)
# Create bot via @BotFather, then set token and username
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=your_bot_username
# Temporarily disabled (does not work yet) — set to true to re-enable
TELEGRAM_ENABLED=false
# Dev: allow TEST ecosystem
ENABLE_TEST_MODE=true
